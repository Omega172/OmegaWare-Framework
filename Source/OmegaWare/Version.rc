#include <winres.h>
#include "Version.hpp"

VS_VERSION_INFO VERSIONINFO
FILEVERSION OMEGAWARE_VERSION_MAJOR, OMEGAWARE_VERSION_MINOR, OMEGAWARE_VERSION_PATCH, 0
PRODUCTVERSION OMEGAWARE_VERSION_MAJOR, OMEGAWARE_VERSION_MINOR, OMEGAWARE_VERSION_PATCH, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", OMEGAWARE_NAME
            VALUE "FileDescription", OMEGAWARE_NAME " framework for " OMEGAWARE_GAME
            VALUE "FileVersion", OMEGAWARE_VERSION
            VALUE "ProductName", OMEGAWARE_NAME
            VALUE "ProductVersion", OMEGAWARE_VERSION
            VALUE "Comments", "Target game: " OMEGAWARE_GAME
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
